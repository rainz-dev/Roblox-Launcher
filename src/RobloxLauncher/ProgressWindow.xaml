<Window x:Class="RobloxLauncher.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460" Height="220"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        FontFamily="{StaticResource BodyFont}" Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <!-- The launch window: updates if needed, then starts Roblox. Drag anywhere to move. -->
    <Border Background="{StaticResource BackgroundBrush}" CornerRadius="{StaticResource WindowRadius}" Padding="28"
            MouseLeftButtonDown="OnMouseDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Button x:Name="SettingsButton" Style="{StaticResource SecondaryButton}" Width="36" Height="36" Padding="0"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnSettingsClicked"
                    ToolTip="Settings" AutomationProperties.Name="Settings">
                <!-- Gear icon -->
                <Path Width="16" Height="16" Stretch="Uniform" Fill="{StaticResource TextSoftBrush}"
                      Data="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61 l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41 h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87 C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.07,0.94l-2.03,1.58 c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54 c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96 c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.47-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6 s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z" />
            </Button>
            <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource LogoMark}" Width="32" Height="32" CornerRadius="10">
                    <TextBlock Text="R" FontFamily="{StaticResource HeadingFont}" FontWeight="Bold" FontSize="18"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="NameText" Margin="12,0,0,0" VerticalAlignment="Center"
                           FontFamily="{StaticResource HeadingFont}" FontWeight="Bold" FontSize="18" />
            </StackPanel>

            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <DockPanel Margin="0,0,0,10">
                    <TextBlock x:Name="DetailText" DockPanel.Dock="Right" FontSize="13" Foreground="{StaticResource MutedBrush}"
                               TextTrimming="CharacterEllipsis" MaxWidth="200" />
                    <TextBlock x:Name="StatusText" Text="Starting…" FontSize="15" FontWeight="SemiBold" />
                </DockPanel>
                <ProgressBar x:Name="Bar" Style="{StaticResource LauncherProgressBar}" IsIndeterminate="True" />
            </StackPanel>

            <Button Grid.Row="2" x:Name="CancelButton" Style="{StaticResource SecondaryButton}" Content="Cancel"
                    Height="36" FontSize="13" Padding="16,0" HorizontalAlignment="Right" Click="OnCancelClicked" />
        </Grid>
    </Border>
</Window>
