<Window x:Class="RobloxLauncher.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <StackPanel Margin="20">
        <TextBlock x:Name="StatusText" Text="Starting…" FontSize="14" Margin="0,0,0,12" />
        <ProgressBar x:Name="Bar" Height="8" Maximum="100" IsIndeterminate="True" />
        <TextBlock x:Name="DetailText" Foreground="Gray" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
        <Button x:Name="CancelButton" Content="Cancel" Width="90" HorizontalAlignment="Right"
                Margin="0,16,0,0" Click="OnCancelClicked" />
    </StackPanel>
</Window>
