<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Windows app: windows, theme, link registration, registry tweaks. Logic lives in RobloxLauncher.Core. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Lets the project build (not run) on non-Windows machines, e.g. CI. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>RobloxLauncher</AssemblyName>
    <RootNamespace>RobloxLauncher</RootNamespace>
    <Version>0.3.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RobloxLauncher.Core\RobloxLauncher.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Inter and Space Grotesk, embedded so the launcher looks the same on every PC. -->
    <Resource Include="Fonts\*.ttf" />
  </ItemGroup>

</Project>
