<Window x:Class="RobloxLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1100" Height="680"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource BodyFont}" Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <!-- The whole window is one rounded block; the Windows frame is replaced by our own title bar. -->
    <Border Background="{StaticResource BackgroundBrush}" CornerRadius="{StaticResource WindowRadius}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title bar: drag to move -->
            <Border Background="{StaticResource TitleBarBrush}" CornerRadius="18,18,0,0" MouseLeftButtonDown="OnTitleBarMouseDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Border Style="{StaticResource LogoMark}" Width="20" Height="20" CornerRadius="6">
                            <TextBlock Text="R" FontFamily="{StaticResource HeadingFont}" FontWeight="Bold" FontSize="12"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="TitleText" Margin="10,0,0,0" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSoftBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource TitleBarButton}" Click="OnMinimizeClicked" AutomationProperties.Name="Minimize">
                            <Path Data="M0,0.5 H10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" />
                        </Button>
                        <Button Style="{StaticResource TitleBarCloseButton}" Click="OnCloseClicked" AutomationProperties.Name="Close">
                            <Path Data="M0,0 L9,9 M9,0 L0,9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border Background="{StaticResource SidebarBrush}" CornerRadius="0,0,0,18" Padding="12,20">
                    <DockPanel LastChildFill="False">
                        <TextBlock x:Name="VersionFooter" DockPanel.Dock="Bottom" Margin="12" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                        <StackPanel DockPanel.Dock="Top">
                            <RadioButton Style="{StaticResource NavItem}" Tag="home" Content="Home" IsChecked="True" Checked="OnNavChecked" />
                            <RadioButton Style="{StaticResource NavItem}" Tag="performance" Content="Performance" Checked="OnNavChecked" />
                            <RadioButton Style="{StaticResource NavItem}" Tag="FastFlags" Checked="OnNavChecked">
                                <DockPanel><Border DockPanel.Dock="Right" Background="{StaticResource RaisedBrush}" CornerRadius="8" Padding="8,2"><TextBlock Text="Soon" FontSize="11" Foreground="{StaticResource TextSoftBrush}" /></Border><TextBlock Text="FastFlags" /></DockPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource NavItem}" Tag="Mods" Checked="OnNavChecked">
                                <DockPanel><Border DockPanel.Dock="Right" Background="{StaticResource RaisedBrush}" CornerRadius="8" Padding="8,2"><TextBlock Text="Soon" FontSize="11" Foreground="{StaticResource TextSoftBrush}" /></Border><TextBlock Text="Mods" /></DockPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource NavItem}" Tag="Servers" Checked="OnNavChecked">
                                <DockPanel><Border DockPanel.Dock="Right" Background="{StaticResource RaisedBrush}" CornerRadius="8" Padding="8,2"><TextBlock Text="Soon" FontSize="11" Foreground="{StaticResource TextSoftBrush}" /></Border><TextBlock Text="Servers" /></DockPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource NavItem}" Tag="settings" Content="Settings" Checked="OnNavChecked" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Pages: one is visible at a time -->
                <Grid Grid.Column="1">

                    <!-- Home -->
                    <Grid x:Name="HomePage" Margin="56,48">
                        <StackPanel VerticalAlignment="Top">
                            <TextBlock Text="ROBLOX" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentTextBrush}" Margin="0,0,0,12" />
                            <TextBlock Text="Ready to play" Style="{StaticResource HeadingText}" FontSize="64" />
                            <TextBlock x:Name="InstalledVersionText" Margin="0,12,0,0" FontSize="15" Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>

                        <StackPanel VerticalAlignment="Bottom">
                            <!-- Shown while updating / launching -->
                            <StackPanel x:Name="LaunchProgressPanel" Visibility="Collapsed" Margin="0,0,0,20" MaxWidth="520" HorizontalAlignment="Left" Width="520">
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock x:Name="LaunchDetailText" DockPanel.Dock="Right" FontSize="13" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock x:Name="LaunchStatusText" FontSize="15" FontWeight="SemiBold" />
                                </DockPanel>
                                <ProgressBar x:Name="LaunchProgressBar" Style="{StaticResource LauncherProgressBar}" IsIndeterminate="True" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="PlayButton" Style="{StaticResource PrimaryButton}" Content="PLAY" Click="OnPlayClicked" />
                                <Button x:Name="CancelLaunchButton" Style="{StaticResource SecondaryButton}" Content="Cancel" Margin="12,0,0,0"
                                        Height="56" Visibility="Collapsed" Click="OnCancelLaunchClicked" />
                                <TextBlock x:Name="PlayHintText" Text="Opens the Roblox home screen" Margin="16,0,0,0" VerticalAlignment="Center"
                                           FontSize="13" Foreground="{StaticResource MutedBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Performance -->
                    <ScrollViewer x:Name="PerformancePage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="56,40">
                            <TextBlock Text="Performance" Style="{StaticResource HeadingText}" />
                            <TextBlock Text="Applied every time Roblox launches." Style="{StaticResource MutedText}" FontSize="14" Margin="0,6,0,24" />

                            <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                                <DockPanel>
                                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Margin="24,0,0,0"
                                              IsChecked="{Binding HighPriority}" Click="OnSettingChanged" AutomationProperties.Name="High CPU priority" />
                                    <StackPanel>
                                        <TextBlock Text="High CPU priority" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Text="Gives Roblox priority over background apps on your processor." Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                                <DockPanel>
                                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Margin="24,0,0,0"
                                              IsChecked="{Binding UseDedicatedGpu}" Click="OnSettingChanged" AutomationProperties.Name="Use dedicated GPU" />
                                    <StackPanel>
                                        <TextBlock Text="Use dedicated GPU" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Text="Tells Windows to always run Roblox on your graphics card, not integrated graphics. Only matters on PCs that have both." Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                                <DockPanel>
                                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Margin="24,0,0,0"
                                              IsChecked="{Binding DisableFullscreenOptimizations}" Click="OnSettingChanged" AutomationProperties.Name="Disable fullscreen optimizations" />
                                    <StackPanel>
                                        <TextBlock Text="Disable fullscreen optimizations" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Text="Can lower input lag in fullscreen on some PCs. Same as the checkbox in the .exe's Compatibility settings." Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <DockPanel>
                                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Margin="24,0,0,0"
                                              IsChecked="{Binding CloseAfterLaunch}" Click="OnSettingChanged" AutomationProperties.Name="Close launcher after Roblox starts" />
                                    <StackPanel>
                                        <TextBlock Text="Close launcher after Roblox starts" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Text="Frees memory while you play." Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Settings -->
                    <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="56,40">
                            <TextBlock Text="Settings" Style="{StaticResource HeadingText}" Margin="0,0,0,24" />

                            <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="20">
                                <StackPanel>
                                    <TextBlock Text="Roblox links" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="Game links from roblox.com open with this launcher." Style="{StaticResource MutedText}" Margin="0,4,0,12" />
                                    <WrapPanel>
                                        <Button Style="{StaticResource SecondaryButton}" Content="Re-register links" Margin="0,0,12,0" Click="OnRegisterClicked" />
                                        <Button Style="{StaticResource SecondaryButton}" Content="Give links back to Roblox" Click="OnUnregisterClicked" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Padding="20">
                                <StackPanel>
                                    <TextBlock Text="Troubleshooting" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="Reinstalling deletes the installed Roblox build; the next PLAY installs it again." Style="{StaticResource MutedText}" Margin="0,4,0,12" />
                                    <WrapPanel>
                                        <Button Style="{StaticResource SecondaryButton}" Content="Open logs folder" Margin="0,0,12,0" Click="OnOpenLogsClicked" />
                                        <Button Style="{StaticResource SecondaryButton}" Content="Reinstall Roblox" Click="OnReinstallClicked" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock x:Name="SettingsStatusText" Margin="4,16,0,0" FontSize="13" Foreground="{StaticResource AccentTextBrush}" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Placeholder for pages coming in later steps -->
                    <StackPanel x:Name="SoonPage" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="SoonTitle" Style="{StaticResource HeadingText}" HorizontalAlignment="Center" />
                        <TextBlock Text="Coming in a later step." Style="{StaticResource MutedText}" FontSize="14" HorizontalAlignment="Center" Margin="0,8,0,0" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
